; SpecTalkZX 1.4.1 example configuration
; Classic and native Next: copy as /SYS/CONFIG/SPECTALK.CFG or /SYS/SPECTALK.CFG.
; Spectranext: /CFG/SPECTALK.CFG in local cartridge XFS.
; Boolean values: 0=off, 1=on unless noted.

nick=MyNick
server=irc.libera.chat
port=6667
pass=
nickpass=
nickserv=NickServ
; authcmd= is written by /login once the service confirms it (plaintext).
; Do not add it by hand: an empty value replaces nickpass.

autoconnect=0
autojoin=0
channels=#spectrum,#zx
; bookmark= is written by A in !bm: 1-5 starts with that bookmark,
; 129-133 also enables autojoin, 128 disables both. Leave it out to use this file.

theme=1
timestamps=2
beep=1
click=1
traffic=1
divider=1
countsync=1
notif=1
nickcolor=1

autoaway=0
tz=1
tzlast=1

friends=Friend1,Friend2
ignores=NoisyNick
